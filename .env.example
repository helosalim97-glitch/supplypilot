# Copy to .env for local development. Values here are for local use only.
POSTGRES_USER=supplypilot
POSTGRES_PASSWORD=supplypilot_local
POSTGRES_DB=supplypilot
POSTGRES_PORT=5432
REDIS_PORT=6379
# API (apps/api)
API_PORT=3001
DATABASE_URL=postgres://supplypilot:supplypilot_local@localhost:5432/supplypilot
IMPORT_WORKER_POLL_MS=2000
IMPORT_STALE_AFTER_SECONDS=600
# Web (apps/web)
SUPPLYPILOT_API_URL=http://localhost:3001
